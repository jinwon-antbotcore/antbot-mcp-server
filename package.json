{
  "name": "antbot-mcp-server",
  "version": "1.0.0.0",
  "description": "mcp server for antbot",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "cleanbuild": "npm run clean && npm run build",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "adm-zip": "^0.5.16",
    "jsdom": "^26.1.0",
    "rxjs": "^7.8.2",
    "sudo-prompt": "^9.2.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.3",
    "@types/xml2js": "^0.4.14",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.3"
  }
}
